VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor: configurar con `supabase secrets set`, nunca con prefijo VITE_.
# No copies estos valores a Netlify ni al frontend.
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Opcionales: permiten cambiar el modelo sin modificar el código.
GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
