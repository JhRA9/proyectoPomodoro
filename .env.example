VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Activar solo después de probar la función y la migración v2 en staging.
VITE_WORKSPACE_AI_V2_READY=false
VITE_WORKSPACE_AREA_SUGGESTIONS_READY=false
# Enable only after the optional snapshot CAS transition is installed and tested.
VITE_STUDYHUB_SNAPSHOT_RPC=false

# Solo servidor: configurar con `supabase secrets set`, nunca con prefijo VITE_.
# No copies estos valores a Netlify ni al frontend.
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Verificar los modelos disponibles en staging antes de habilitar IA.
# GEMINI_MODEL es obligatorio para sugerencias de áreas.
GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
